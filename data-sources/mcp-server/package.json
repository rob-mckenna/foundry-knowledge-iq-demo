{
  "name": "healthcare-payor-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing healthcare payor data tools for Azure AI Foundry Knowledge Base",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:http": "node server.js --transport=http",
    "dev": "node --watch server.js",
    "dev:http": "node --watch server.js --transport=http",
    "test": "node test-tools.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "healthcare",
    "azure-ai-foundry",
    "knowledge-base"
  ]
}
